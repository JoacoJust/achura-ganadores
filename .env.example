# Base de datos compartida con la app de votación (la misma que usa achura-awards).
# Se usa para dos cosas:
#   1) npm run sync -> genera data/resultados.json con los votos reales.
#   2) guardar los votos del "Outfit del día" (colección outfit_votos).
MONGO_URI=

# Contraseña de la sección privada de ternas y resultados
RESULTADOS_PASSWORD=achura2026

# Contraseña para resetear los votos de Outfit del día (POST /api/outfit/reset)
ADMIN_PASSWORD=achura2026

# Puerto del servidor (en Render lo asigna la plataforma)
PORT=3003
